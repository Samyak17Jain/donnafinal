{
  "name": "donna",
  "version": "0.2.2",
  "description": "A personal AI-powered desktop assistant for real-time conversations, transcription and contextual assistance.",
  "license": "UNLICENSED",
  "author": "Samyak Jain",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "prepare:whisper": "node scripts/prepare-whisper-runtime.js",
    "verify:whisper-runtime": "node scripts/verify-whisper-runtime.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac zip",
    "dist:mac": "electron-builder --mac zip",
    "dist:win": "electron-builder --win",
    "pack:win": "electron-builder --win --dir",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:linux:arm64": "electron-builder --linux AppImage --arm64"
  },
  "keywords": [
    "electron",
    "overlay",
    "ai",
    "assistant",
    "windows",
    "cross-platform"
  ],
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "^26.15.3",
    "extract-zip": "^2.0.1",
    "tar": "^7.5.22"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/genai": "^2.12.0",
    "mammoth": "^1.8.0",
    "openai": "^4.73.0",
    "pdf-parse": "^1.1.1",
    "ws": "^8.18.0"
  }
}
